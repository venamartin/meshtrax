<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Offline map packs (files/maps/) are large and can be
     downloaded again, so they stay out of cloud backups and device transfers;
     otherwise they would push Auto Backup past its 25 MB quota. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="maps/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="maps/" />
    </device-transfer>
</data-extraction-rules>
