{
  "version": 8,
  "name": "Modern",
  "metadata": {
    "ovm:status": "Clean, light look: white roads on soft pastels, flat buildings, subtle terrain."
  },
  "glyphs": "{glyphs}",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "pmtiles://{pack:osm}",
      "attribution": "© OpenMapTiles © OpenStreetMap contributors"
    },
    "base": {
      "type": "vector",
      "url": "pmtiles://{pack:base}",
      "attribution": "USGS The National Map"
    },
    "contours": {
      "type": "vector",
      "url": "pmtiles://{pack:contours}",
      "attribution": "USGS 3DEP"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f6f4f0"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "wood",
          "#d9ead0",
          "grass",
          "#e4efdb",
          "farmland",
          "#f2f0e6",
          "wetland",
          "#d8ebe6",
          "sand",
          "#f5ecd5",
          "rock",
          "#e9e6e1",
          "ice",
          "#f7fafc",
          "#e4efdb"
        ],
        "fill-opacity": 0.75
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "residential",
          "#efebe6",
          [
            "commercial",
            "retail",
            "industrial"
          ],
          "#f3e9e6",
          "cemetery",
          "#e4efdb",
          [
            "school",
            "college",
            "university",
            "hospital"
          ],
          "#f2ecdf",
          "#efebe6"
        ],
        "fill-opacity": 0.7
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "osm",
      "source-layer": "park",
      "filter": [
        "!",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "national_marine_sanctuary",
            "state_marine_conservation_area",
            "state_marine_reserve",
            "state_marine_park",
            "marine_protected_area"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "fill-color": "#cfe8c4",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "hillshade",
      "type": "fill",
      "source": "base",
      "source-layer": "hillshade",
      "paint": {
        "fill-color": [
          "case",
          [
            "<",
            [
              "get",
              "level"
            ],
            0
          ],
          "#ffffff",
          "#2b3a4a"
        ],
        "fill-opacity": [
          "match",
          [
            "get",
            "level"
          ],
          -1,
          0.25,
          1,
          0.03,
          2,
          0.06,
          3,
          0.1,
          4,
          0.14,
          0
        ],
        "fill-antialias": false
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a9d4f5"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#8cc3ee",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          [
            "match",
            [
              "get",
              "class"
            ],
            "river",
            1.2,
            0.4
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            "river",
            4,
            1.4
          ]
        ]
      }
    },
    {
      "id": "contour",
      "type": "line",
      "source": "contours",
      "source-layer": "contour",
      "paint": {
        "line-color": [
          "case",
          [
            "==",
            [
              "get",
              "idx"
            ],
            1
          ],
          "#c4ae96",
          "#d9c9b6"
        ],
        "line-opacity": 0.9,
        "line-width": [
          "case",
          [
            "==",
            [
              "get",
              "idx"
            ],
            1
          ],
          0.8,
          0.4
        ]
      }
    },
    {
      "id": "park-outline",
      "type": "line",
      "source": "osm",
      "source-layer": "park",
      "minzoom": 9,
      "filter": [
        "!",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "national_marine_sanctuary",
            "state_marine_conservation_area",
            "state_marine_reserve",
            "state_marine_park",
            "marine_protected_area"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "line-color": "#a9d19a",
        "line-width": 1,
        "line-opacity": 0.8,
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "aeroway",
      "type": "line",
      "source": "osm",
      "source-layer": "aeroway",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "runway",
          "taxiway"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#dcdbe6",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          16,
          14
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "osm",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e8e3dc",
        "fill-outline-color": "#d8d1c8",
        "fill-opacity": 1
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary",
          "minor",
          "service"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#dcd6cd",
        "line-gap-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          8,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            1.38,
            "primary",
            0.9199999999999999,
            0.345
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            13.799999999999999,
            [
              "primary",
              "secondary"
            ],
            10.35,
            "tertiary",
            8.049999999999999,
            "minor",
            5.75,
            3.4499999999999997
          ]
        ],
        "line-width": 1
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary",
          "minor",
          "service"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk"
          ],
          "#ffd58a",
          "primary",
          "#fff3c9",
          "secondary",
          "#ffffff",
          "tertiary",
          "#ffffff",
          "#ffffff"
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          8,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            1.38,
            "primary",
            0.9199999999999999,
            0.345
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            13.799999999999999,
            [
              "primary",
              "secondary"
            ],
            10.35,
            "tertiary",
            8.049999999999999,
            "minor",
            5.75,
            3.4499999999999997
          ]
        ]
      }
    },
    {
      "id": "track",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "track"
      ],
      "paint": {
        "line-color": "#b89f7d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.8,
          16,
          2.2
        ],
        "line-dasharray": [
          3,
          1.5
        ]
      }
    },
    {
      "id": "trail-halo",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "class"
          ],
          "path"
        ],
        [
          "match",
          [
            "get",
            "subclass"
          ],
          [
            "path",
            "bridleway"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": 0.6,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          3,
          16,
          6
        ]
      }
    },
    {
      "id": "trail",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "class"
          ],
          "path"
        ],
        [
          "match",
          [
            "get",
            "subclass"
          ],
          [
            "path",
            "bridleway"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "line-color": "#e07a5f",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.9,
          16,
          2.4
        ],
        "line-dasharray": [
          2,
          1
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#b3b0aa",
        "line-width": 1.2,
        "line-dasharray": [
          4,
          2
        ]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "osm",
      "source-layer": "boundary",
      "filter": [
        "<=",
        [
          "get",
          "admin_level"
        ],
        6
      ],
      "paint": {
        "line-color": "#c3b3d6",
        "line-width": 1,
        "line-dasharray": [
          4,
          2
        ]
      }
    },
    {
      "id": "contour-label",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "idx"
        ],
        1
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "concat",
          [
            "to-string",
            [
              "get",
              "ele_ft"
            ]
          ],
          " ft"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#b39a7e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "imperial"
      }
    },
    {
      "id": "contour-label-m",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "idx"
        ],
        1
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "concat",
          [
            "to-string",
            [
              "get",
              "ele_m"
            ]
          ],
          " m"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#b39a7e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "metric"
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "osm",
      "source-layer": "water_name",
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 12
      },
      "paint": {
        "text-color": "#4a86b8",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "waterway-name",
      "type": "symbol",
      "source": "osm",
      "source-layer": "waterway",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#4a86b8",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          [
            "get",
            "ref"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#55595e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "trail-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "class"
          ],
          "path"
        ],
        [
          "!=",
          [
            "get",
            "subclass"
          ],
          "footway"
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#e07a5f",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "poi",
      "type": "symbol",
      "source": "osm",
      "source-layer": "poi",
      "minzoom": 16,
      "filter": [
        "<=",
        [
          "get",
          "rank"
        ],
        10
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#7a7f85",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "peak",
      "type": "symbol",
      "source": "osm",
      "source-layer": "mountain_peak",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "concat",
          "▲ ",
          [
            "coalesce",
            [
              "get",
              "name"
            ],
            ""
          ],
          "\n",
          [
            "case",
            [
              "has",
              "ele_ft"
            ],
            [
              "concat",
              [
                "to-string",
                [
                  "get",
                  "ele_ft"
                ]
              ],
              " ft"
            ],
            ""
          ]
        ],
        "text-font": [
          "Noto Sans Medium"
        ],
        "text-size": 11,
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#7a5a3a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "imperial"
      }
    },
    {
      "id": "peak-m",
      "type": "symbol",
      "source": "osm",
      "source-layer": "mountain_peak",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "concat",
          "▲ ",
          [
            "coalesce",
            [
              "get",
              "name"
            ],
            ""
          ],
          "\n",
          [
            "case",
            [
              "has",
              "ele"
            ],
            [
              "concat",
              [
                "to-string",
                [
                  "get",
                  "ele"
                ]
              ],
              " m"
            ],
            ""
          ]
        ],
        "text-font": [
          "Noto Sans Medium"
        ],
        "text-size": 11,
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#7a5a3a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "metric"
      }
    },
    {
      "id": "place",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "city",
          "town",
          "village",
          "hamlet",
          "suburb"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Medium"
        ],
        "text-size": [
          "match",
          [
            "get",
            "class"
          ],
          "city",
          17,
          "town",
          15,
          "village",
          12.5,
          11
        ],
        "text-transform": "none",
        "text-letter-spacing": 0.02
      },
      "paint": {
        "text-color": "#2f3337",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    }
  ]
}
