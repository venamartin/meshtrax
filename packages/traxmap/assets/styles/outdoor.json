{
  "version": 8,
  "name": "Outdoor",
  "metadata": {
    "ovm:status": "Hiking: strong terrain, bold contours, real trails only, peaks, muted roads."
  },
  "glyphs": "{glyphs}",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "pmtiles://{pack:osm}",
      "attribution": "© OpenMapTiles © OpenStreetMap contributors"
    },
    "base": {
      "type": "vector",
      "url": "pmtiles://{pack:base}",
      "attribution": "USGS The National Map"
    },
    "contours": {
      "type": "vector",
      "url": "pmtiles://{pack:contours}",
      "attribution": "USGS 3DEP"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f3efe4"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "wood",
          "#bfd9a8",
          "grass",
          "#d9e8c2",
          "farmland",
          "#efe9d2",
          "wetland",
          "#c9e2d6",
          "sand",
          "#f0e2bd",
          "rock",
          "#ddd6cb",
          "ice",
          "#f2f7fa",
          "#d9e8c2"
        ],
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "residential",
          "#ebe5dc",
          [
            "commercial",
            "retail",
            "industrial"
          ],
          "#ece0dc",
          "cemetery",
          "#d9e8c2",
          [
            "school",
            "college",
            "university",
            "hospital"
          ],
          "#ece3cf",
          "#ebe5dc"
        ],
        "fill-opacity": 0.5
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "osm",
      "source-layer": "park",
      "filter": [
        "!",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "national_marine_sanctuary",
            "state_marine_conservation_area",
            "state_marine_reserve",
            "state_marine_park",
            "marine_protected_area"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "fill-color": "#b8dca0",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "hillshade",
      "type": "fill",
      "source": "base",
      "source-layer": "hillshade",
      "paint": {
        "fill-color": [
          "case",
          [
            "<",
            [
              "get",
              "level"
            ],
            0
          ],
          "#fffbe8",
          "#2a2016"
        ],
        "fill-opacity": [
          "match",
          [
            "get",
            "level"
          ],
          -1,
          0.3,
          1,
          0.08,
          2,
          0.16,
          3,
          0.25,
          4,
          0.35,
          0
        ],
        "fill-antialias": false
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "paint": {
        "fill-color": "#93c4e8"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#4f95cf",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          [
            "match",
            [
              "get",
              "class"
            ],
            "river",
            1.2,
            0.4
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            "river",
            4,
            1.4
          ]
        ]
      }
    },
    {
      "id": "contour",
      "type": "line",
      "source": "contours",
      "source-layer": "contour",
      "paint": {
        "line-color": [
          "case",
          [
            "==",
            [
              "get",
              "idx"
            ],
            1
          ],
          "#8a5a30",
          "#a87a50"
        ],
        "line-opacity": 0.85,
        "line-width": [
          "case",
          [
            "==",
            [
              "get",
              "idx"
            ],
            1
          ],
          1.3,
          0.55
        ]
      }
    },
    {
      "id": "park-outline",
      "type": "line",
      "source": "osm",
      "source-layer": "park",
      "minzoom": 9,
      "filter": [
        "!",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "national_marine_sanctuary",
            "state_marine_conservation_area",
            "state_marine_reserve",
            "state_marine_park",
            "marine_protected_area"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "line-color": "#3f8a3a",
        "line-width": 2,
        "line-opacity": 0.8,
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "aeroway",
      "type": "line",
      "source": "osm",
      "source-layer": "aeroway",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "runway",
          "taxiway"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#cfcbd8",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          16,
          14
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "osm",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d9d1c5",
        "fill-outline-color": "#c5bbac",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary",
          "minor",
          "service"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#a9a090",
        "line-gap-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          8,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            0.96,
            "primary",
            0.6400000000000001,
            0.24
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            9.600000000000001,
            [
              "primary",
              "secondary"
            ],
            7.2,
            "tertiary",
            5.6000000000000005,
            "minor",
            4.0,
            2.4000000000000004
          ]
        ],
        "line-width": 0.6
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary",
          "minor",
          "service"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk"
          ],
          "#e8a75b",
          "primary",
          "#f2cf8a",
          "secondary",
          "#f7e6b5",
          "tertiary",
          "#ffffff",
          "#ffffff"
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          8,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            0.96,
            "primary",
            0.6400000000000001,
            0.24
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            9.600000000000001,
            [
              "primary",
              "secondary"
            ],
            7.2,
            "tertiary",
            5.6000000000000005,
            "minor",
            4.0,
            2.4000000000000004
          ]
        ]
      }
    },
    {
      "id": "track",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "track"
      ],
      "paint": {
        "line-color": "#8a6a3e",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.8,
          16,
          2.2
        ],
        "line-dasharray": [
          3,
          1.5
        ]
      }
    },
    {
      "id": "trail-halo",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "class"
          ],
          "path"
        ],
        [
          "match",
          [
            "get",
            "subclass"
          ],
          [
            "path",
            "bridleway"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": 0.7,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          3,
          16,
          6
        ]
      }
    },
    {
      "id": "trail",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "class"
          ],
          "path"
        ],
        [
          "match",
          [
            "get",
            "subclass"
          ],
          [
            "path",
            "bridleway"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "line-color": "#d1340f",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          1.3,
          16,
          3.2
        ],
        "line-dasharray": [
          2,
          1
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#8f8a84",
        "line-width": 1.2,
        "line-dasharray": [
          4,
          2
        ]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "osm",
      "source-layer": "boundary",
      "filter": [
        "<=",
        [
          "get",
          "admin_level"
        ],
        6
      ],
      "paint": {
        "line-color": "#9d7fb6",
        "line-width": 1,
        "line-dasharray": [
          4,
          2
        ]
      }
    },
    {
      "id": "contour-label",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "idx"
        ],
        1
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "concat",
          [
            "to-string",
            [
              "get",
              "ele_ft"
            ]
          ],
          " ft"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#7a4f26",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "imperial"
      }
    },
    {
      "id": "contour-label-m",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "idx"
        ],
        1
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "concat",
          [
            "to-string",
            [
              "get",
              "ele_m"
            ]
          ],
          " m"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#7a4f26",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "metric"
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "osm",
      "source-layer": "water_name",
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 12
      },
      "paint": {
        "text-color": "#2f6fa8",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "waterway-name",
      "type": "symbol",
      "source": "osm",
      "source-layer": "waterway",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#2f6fa8",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          [
            "get",
            "ref"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#3d3a35",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
