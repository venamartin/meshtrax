          "concat",
          "▲ ",
          [
            "coalesce",
            [
              "get",
              "name"
            ],
            ""
          ],
          "\n",
          [
            "case",
            [
              "has",
              "ele_ft"
            ],
            [
              "concat",
              [
                "to-string",
                [
                  "get",
                  "ele_ft"
                ]
              ],
              " ft"
            ],
            ""
          ]
        ],
        "text-font": [
          "Noto Sans Medium"
        ],
        "text-size": 11,
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#5a2e0e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "imperial"
      }
    },
    {
      "id": "peak-m",
      "type": "symbol",
      "source": "osm",
      "source-layer": "mountain_peak",
      "minzoom": 9,
      "layout": {
        "text-field": [
          "concat",
          "▲ ",
          [
            "coalesce",
            [
              "get",
              "name"
            ],
            ""
          ],
          "\n",
          [
            "case",
            [
              "has",
              "ele"
            ],
            [
              "concat",
              [
