{
  "version": 8,
  "name": "Dark",
  "metadata": {
    "ovm:status": "Dark mode: OSM + USGS hillshade + contours. Easy on the eyes at night (not the red night-vision style).",
    "ovm:dark": true
  },
  "glyphs": "{glyphs}",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "pmtiles://{pack:osm}",
      "attribution": "© OpenMapTiles © OpenStreetMap contributors"
    },
    "base": {
      "type": "vector",
      "url": "pmtiles://{pack:base}",
      "attribution": "USGS The National Map"
    },
    "contours": {
      "type": "vector",
      "url": "pmtiles://{pack:contours}",
      "attribution": "USGS 3DEP"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#1c2026"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "wood",
          "#1f2b24",
          "grass",
          "#222a24",
          "farmland",
          "#23262a",
          "wetland",
          "#1e2a2c",
          "sand",
          "#2b2a26",
          "rock",
          "#26282c",
          "ice",
          "#2c3238",
          "#222a24"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "residential",
          "#23272d",
          [
            "commercial",
            "retail",
            "industrial"
          ],
          "#2a272d",
          "cemetery",
          "#222a24",
          [
            "school",
            "college",
            "university",
            "hospital"
          ],
          "#29282a",
          "#23272d"
        ],
        "fill-opacity": 0.7
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "osm",
      "source-layer": "park",
      "filter": [
        "!",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "national_marine_sanctuary",
            "state_marine_conservation_area",
            "state_marine_reserve",
            "state_marine_park",
            "marine_protected_area"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "fill-color": "#203024",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "hillshade",
      "type": "fill",
      "source": "base",
      "source-layer": "hillshade",
      "paint": {
        "fill-color": [
          "case",
          [
            "<",
            [
              "get",
              "level"
            ],
            0
          ],
          "#ffffff",
          "#000000"
        ],
        "fill-opacity": [
          "match",
          [
            "get",
            "level"
          ],
          -1,
          0.05,
          1,
          0.12,
          2,
          0.22,
          3,
          0.32,
          4,
          0.42,
          0
        ],
        "fill-antialias": false
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "paint": {
        "fill-color": "#13283a"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#2b5578",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          [
            "match",
            [
              "get",
              "class"
            ],
            "river",
            1.2,
            0.4
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            "river",
            4,
            1.4
          ]
        ]
      }
    },
    {
      "id": "contour",
      "type": "line",
      "source": "contours",
      "source-layer": "contour",
      "paint": {
        "line-color": [
          "case",
          [
            "==",
            [
              "get",
              "idx"
            ],
            1
          ],
          "#7c6a55",
          "#5b4e40"
        ],
        "line-opacity": 0.8,
        "line-width": [
          "case",
          [
            "==",
            [
              "get",
              "idx"
            ],
            1
          ],
          1.0,
          0.45
        ]
      }
    },
    {
      "id": "park-outline",
      "type": "line",
      "source": "osm",
      "source-layer": "park",
      "minzoom": 9,
      "filter": [
        "!",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "national_marine_sanctuary",
            "state_marine_conservation_area",
            "state_marine_reserve",
            "state_marine_park",
            "marine_protected_area"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "line-color": "#3f6b4a",
        "line-width": 1,
        "line-opacity": 0.8,
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "aeroway",
      "type": "line",
      "source": "osm",
      "source-layer": "aeroway",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "runway",
          "taxiway"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#3a3f48",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          16,
          14
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "osm",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#2c3138",
        "fill-outline-color": "#363c44",
        "fill-opacity": 1
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary",
          "minor",
          "service"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#14171b",
        "line-gap-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          8,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            1.2,
            "primary",
            0.8,
            0.3
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            12.0,
            [
              "primary",
              "secondary"
            ],
            9.0,
            "tertiary",
            7.0,
            "minor",
            5.0,
            3.0
          ]
        ],
        "line-width": 0.8
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary",
          "minor",
          "service"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk"
          ],
          "#9a7440",
          "primary",
          "#6e6650",
          "secondary",
          "#585548",
          "tertiary",
          "#4a4c50",
          "#3b3f45"
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          8,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            1.2,
            "primary",
            0.8,
            0.3
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            12.0,
            [
              "primary",
              "secondary"
            ],
            9.0,
            "tertiary",
            7.0,
            "minor",
            5.0,
            3.0
          ]
        ]
      }
    },
    {
      "id": "track",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "track"
      ],
      "paint": {
        "line-color": "#7a6a55",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.8,
          16,
          2.2
        ],
        "line-dasharray": [
          3,
          1.5
        ]
      }
    },
    {
      "id": "trail-halo",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "class"
          ],
          "path"
        ],
        [
          "match",
          [
            "get",
            "subclass"
          ],
          [
            "path",
            "bridleway"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "line-color": "#000000",
        "line-opacity": 0,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          3,
          16,
          6
        ]
      }
    },
    {
      "id": "trail",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "class"
          ],
          "path"
        ],
        [
          "match",
          [
            "get",
            "subclass"
          ],
          [
            "path",
            "bridleway"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "line-color": "#d0705f",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.9,
          16,
          2.4
        ],
        "line-dasharray": [
          2,
          1
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#555b63",
        "line-width": 1.2,
        "line-dasharray": [
          4,
          2
        ]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "osm",
      "source-layer": "boundary",
      "filter": [
        "<=",
        [
          "get",
          "admin_level"
        ],
        6
      ],
      "paint": {
        "line-color": "#6b5b80",
        "line-width": 1,
        "line-dasharray": [
          4,
          2
        ]
      }
    },
    {
      "id": "contour-label",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "idx"
        ],
        1
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "concat",
          [
            "to-string",
            [
              "get",
              "ele_ft"
            ]
          ],
          " ft"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#a08c72",
        "text-halo-color": "#1c2026",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "imperial"
      }
    },
    {
      "id": "contour-label-m",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "idx"
        ],
        1
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "concat",
          [
            "to-string",
            [
              "get",
              "ele_m"
            ]
          ],
          " m"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#a08c72",
        "text-halo-color": "#1c2026",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "metric"
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "osm",
      "source-layer": "water_name",
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 12
      },
      "paint": {
        "text-color": "#6f9cc7",
        "text-halo-color": "#1c2026",
        "text-halo-width": 1
      }
    },
    {
      "id": "waterway-name",
      "type": "symbol",
      "source": "osm",
      "source-layer": "waterway",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#6f9cc7",
        "text-halo-color": "#1c2026",
        "text-halo-width": 1
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          [
            "get",
            "ref"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#c9d0d8",
        "text-halo-color": "#1c2026",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "trail-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "class"
          ],
          "path"
        ],
        [
          "!=",
          [
            "get",
            "subclass"
          ],
          "footway"
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#d0705f",
        "text-halo-color": "#1c2026",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "poi",
      "type": "symbol",
      "source": "osm",
      "source-layer": "poi",
      "minzoom": 15,
      "filter": [
        "<=",
        [
          "get",
          "rank"
        ],
        20
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#9aa3ad",
        "text-halo-color": "#1c2026",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "peak",
      "type": "symbol",
      "source": "osm",
      "source-layer": "mountain_peak",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "concat",
          "▲ ",
          [
            "coalesce",
            [
              "get",
              "name"
            ],
            ""
          ],
          "\n",
          [
            "case",
            [
              "has",
              "ele_ft"
            ],
            [
              "concat",
              [
                "to-string",
                [
                  "get",
                  "ele_ft"
                ]
              ],
              " ft"
            ],
            ""
          ]
        ],
        "text-font": [
          "Noto Sans Medium"
        ],
        "text-size": 11,
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#d8b98a",
        "text-halo-color": "#1c2026",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "imperial"
      }
    },
    {
      "id": "peak-m",
      "type": "symbol",
      "source": "osm",
      "source-layer": "mountain_peak",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "concat",
          "▲ ",
          [
            "coalesce",
            [
              "get",
              "name"
            ],
            ""
          ],
          "\n",
          [
            "case",
            [
              "has",
              "ele"
            ],
            [
              "concat",
              [
                "to-string",
                [
                  "get",
                  "ele"
                ]
              ],
              " m"
            ],
            ""
          ]
        ],
        "text-font": [
          "Noto Sans Medium"
        ],
        "text-size": 11,
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#d8b98a",
        "text-halo-color": "#1c2026",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "metric"
      }
    },
    {
      "id": "place",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "city",
          "town",
          "village",
          "hamlet",
          "suburb"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Medium"
        ],
        "text-size": [
          "match",
          [
            "get",
            "class"
          ],
          "city",
          17,
          "town",
          15,
          "village",
          12.5,
          11
        ],
        "text-transform": "none",
        "text-letter-spacing": 0
      },
      "paint": {
        "text-color": "#e6eaef",
        "text-halo-color": "#1c2026",
        "text-halo-width": 2
      }
    }
  ]
}
