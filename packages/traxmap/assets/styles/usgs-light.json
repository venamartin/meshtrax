{
  "version": 8,
  "name": "USGS",
  "metadata": {
    "ovm:status": "Starter style; Phase 3 replaces it. Layer names follow pipeline/SCHEMA.md v1.",
    "ovm:map": "usgs",
    "ovm:requires": [
      "base"
    ],
    "ovm:theme": "light",
    "ovm:family": "standard"
  },
  "glyphs": "{glyphs}",
  "sources": {
    "base": {
      "type": "vector",
      "url": "pmtiles://{pack:base}",
      "attribution": "USGS The National Map"
    },
    "terrain": {
      "type": "vector",
      "url": "pmtiles://{pack:terrain}",
      "attribution": "USGS 3DEP"
    },
    "contours": {
      "type": "vector",
      "url": "pmtiles://{pack:contours}",
      "attribution": "USGS 3DEP"
    },
    "world": {
      "type": "vector",
      "url": "pmtiles://{pack:world}",
      "attribution": "Made with Natural Earth"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f6f3ec"
      }
    },
    {
      "id": "world-urban",
      "type": "fill",
      "source": "world",
      "source-layer": "landuse",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "residential"
        ],
        true,
        false
      ],
      "minzoom": 4,
      "maxzoom": 6,
      "paint": {
        "fill-color": "#e6dfd2"
      }
    },
    {
      "id": "world-ice",
      "type": "fill",
      "source": "world",
      "source-layer": "landcover",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "ice"
        ],
        true,
        false
      ],
      "maxzoom": 6,
      "paint": {
        "fill-color": "#ffffff"
      }
    },
    {
      "id": "world-water",
      "type": "fill",
      "source": "world",
      "source-layer": "water",
      "maxzoom": 6,
      "paint": {
        "fill-color": "#a6cbea"
      }
    },
    {
      "id": "world-river",
      "type": "line",
      "source": "world",
      "source-layer": "waterway",
      "maxzoom": 6,
      "paint": {
        "line-color": "#5b9bd5",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.4,
          6,
          1
        ]
      }
    },
    {
      "id": "world-state",
      "type": "line",
      "source": "world",
      "source-layer": "boundary",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "admin_level"
          ],
          4
        ],
        [
          "==",
          [
            "get",
            "maritime"
          ],
          0
        ]
      ],
      "minzoom": 3,
      "maxzoom": 6,
      "paint": {
        "line-color": "#b9aec4",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.5,
          6,
          0.9
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "world-country",
      "type": "line",
      "source": "world",
      "source-layer": "boundary",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "admin_level"
          ],
          2
        ],
        [
          "==",
          [
            "get",
            "maritime"
          ],
          0
        ]
      ],
      "maxzoom": 6,
      "paint": {
        "line-color": "#8a7a9a",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          1,
          0.6,
          6,
          1.4
        ],
        "line-dasharray": [
          "case",
          [
            "==",
            [
              "get",
              "disputed"
            ],
            1
          ],
          [
            "literal",
            [
              3,
              2
            ]
          ],
          [
            "literal",
            [
              1,
              0
            ]
          ]
        ]
      }
    },
    {
      "id": "world-road",
      "type": "line",
      "source": "world",
      "source-layer": "transportation",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary"
        ],
        true,
        false
      ],
      "minzoom": 4,
      "maxzoom": 6,
      "paint": {
        "line-color": "#e07b39",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.5,
          6,
          1.2
        ]
      }
    },
    {
      "id": "elev_band",
      "type": "fill",
      "source": "terrain",
      "source-layer": "elev_band",
      "paint": {
        "fill-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "get",
            "band_ft"
          ],
          500,
          "#efe8d6",
          1000,
          "#e8dec6",
          1500,
          "#e1d3b5",
          2000,
          "#d9c7a4",
          3000,
          "#cdb68e",
          5000,
          "#bba07a",
          8000,
          "#d3c9b9"
        ],
        "fill-antialias": false
      }
    },
    {
      "id": "woodland",
      "type": "fill",
      "source": "base",
      "source-layer": "woodland",
      "paint": {
        "fill-color": "#cfe3c1",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "hillshade",
      "type": "fill",
      "source": "terrain",
      "source-layer": "hillshade",
      "paint": {
        "fill-color": [
          "case",
          [
            "<",
            [
              "get",
              "level"
            ],
            0
          ],
          "#ffffff",
          "#3d342b"
        ],
        "fill-opacity": [
          "match",
          [
            "get",
            "level"
          ],
          -1,
          0.28,
          1,
          0.09,
          2,
          0.15,
          3,
          0.21,
          4,
          0.27,
          0
        ],
        "fill-antialias": false
      }
    },
    {
      "id": "reserve",
      "type": "line",
      "source": "base",
      "source-layer": "reserve",
      "paint": {
        "line-color": "#6a9a5a",
        "line-width": 1.5,
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "base",
      "source-layer": "water",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "marsh",
          "#bcd9cf",
          "#a6cbea"
        ]
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "base",
      "source-layer": "waterway",
      "filter": [
        "!=",
        [
          "get",
          "kind"
        ],
        "coastline"
      ],
      "paint": {
        "line-color": "#5b9bd5",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.5,
          14,
          1.5
        ]
      }
    },
    {
      "id": "coastline",
      "type": "line",
      "source": "base",
      "source-layer": "waterway",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "coastline"
      ],
      "paint": {
        "line-color": "#3d7fbf",
        "line-width": 1
      }
    },
    {
      "id": "contour",
      "type": "line",
      "source": "contours",
      "source-layer": "contour",
      "paint": {
        "line-color": "#b5835a",
        "line-opacity": 0.8,
        "line-width": [
          "case",
          [
            "==",
            [
              "get",
              "idx"
            ],
            1
          ],
          1.1,
          0.5
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "base",
      "source-layer": "rail",
      "paint": {
        "line-color": "#777",
        "line-width": 1.2,
        "line-dasharray": [
          4,
          2
        ]
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "base",
      "source-layer": "road",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "motorway",
          "#e07b39",
          "major",
          "#f0a050",
          "track",
          "#a08060",
          "#999"
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          8,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "motorway",
            1.5,
            "major",
            1,
            0.3
          ],
          14,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "motorway",
            6,
            "major",
            4.5,
            "ramp",
            3,
            2
          ]
        ]
      }
    },
    {
      "id": "trail",
      "type": "line",
      "source": "base",
      "source-layer": "trail",
      "paint": {
        "line-color": "#c0392b",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          15,
          2.5
        ],
        "line-dasharray": [
          2,
          1
        ]
      }
    },
    {
      "id": "poi",
      "type": "circle",
      "source": "base",
      "source-layer": "poi",
      "paint": {
        "circle-radius": 3,
        "circle-color": "#7d3c98"
      }
    },
    {
      "id": "world-sea-name",
      "type": "symbol",
      "source": "world",
      "source-layer": "water_name",
      "maxzoom": 6,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          1,
          10,
          6,
          12
        ],
        "text-max-width": 10,
        "symbol-sort-key": [
          "get",
          "rank"
        ],
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#3d7fbf",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "world-state-label",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "state"
        ],
        true,
        false
      ],
      "minzoom": 4,
      "maxzoom": 6,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-max-width": 14,
        "symbol-sort-key": [
          "get",
          "rank"
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "world-city-dot",
      "type": "circle",
      "source": "world",
      "source-layer": "place",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "city",
          "town"
        ],
        true,
        false
      ],
      "maxzoom": 6,
      "paint": {
        "circle-radius": 2,
        "circle-color": "#333333",
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 0.8
      }
    },
    {
      "id": "world-city",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "city",
          "town"
        ],
        true,
        false
      ],
      "maxzoom": 6,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "case",
          [
            "==",
            [
              "get",
              "capital"
            ],
            2
          ],
          12,
          [
            "<=",
            [
              "get",
              "rank"
            ],
            3
          ],
          11.5,
          10.5
        ],
        "text-max-width": 8,
        "symbol-sort-key": [
          "get",
          "rank"
        ],
        "text-variable-anchor": [
          "left",
          "right",
          "top",
          "bottom"
        ],
        "text-radial-offset": 0.45
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "world-country-label",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "country"
        ],
        true,
        false
      ],
      "maxzoom": 6,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Medium"
        ],
        "text-size": [
          "step",
          [
            "get",
            "rank"
          ],
          15,
          3,
          13,
          5,
          11
        ],
        "text-max-width": 12,
        "symbol-sort-key": [
          "get",
          "rank"
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#8a7a9a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "contour-label",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "idx"
        ],
        1
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "concat",
          [
            "to-string",
            [
              "get",
              "ele_ft"
            ]
          ],
          " ft"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#8a5a33",
        "text-halo-color": "#fff",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "imperial"
      }
    },
    {
      "id": "contour-label-m",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "idx"
        ],
        1
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "concat",
          [
            "to-string",
            [
              "get",
              "ele_m"
            ]
          ],
          " m"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#8a5a33",
        "text-halo-color": "#fff",
        "text-halo-width": 1.5
      },
      "metadata": {
        "ovm:units": "metric"
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "base",
      "source-layer": "road",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          [
            "get",
            "ref"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#333",
        "text-halo-color": "#fff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "trail-label",
      "type": "symbol",
      "source": "base",
      "source-layer": "trail",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#c0392b",
        "text-halo-color": "#fff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "base",
      "source-layer": "poi",
      "minzoom": 14,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-offset": [
          0,
          1
        ],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#333",
        "text-halo-color": "#fff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "base",
      "source-layer": "place",
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "match",
          [
            "get",
            "kind"
          ],
          "populated_place",
          14,
          11
        ]
      },
      "paint": {
        "text-color": "#333",
        "text-halo-color": "#fff",
        "text-halo-width": 1.5
      }
    }
  ]
}
